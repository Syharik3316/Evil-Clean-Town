# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# development | production. На проде backend пишет предупреждение в лог,
# если CORS_ORIGINS всё ещё "*" или JWT_SECRET_KEY не изменён.
ENVIRONMENT=production

# Режим подключения к БД (см. README, раздел «База данных: внутри Docker или снаружи»).
# По умолчанию backend и Grafana ходят в контейнер db из этого же docker-compose (профиль
# local-db, включён через COMPOSE_PROFILES). Чтобы использовать внешний Postgres (уже
# запущенный на VDS или в облаке, не этим docker-compose):
#   1) впишите его адрес/порт в DB_HOST/DB_PORT,
#   2) убедитесь, что там уже создана роль/база с именем POSTGRES_USER/PASSWORD/DB,
#   3) очистите COMPOSE_PROFILES= (пусто) — тогда локальный контейнер db не запустится.
DB_HOST=db
DB_PORT=5432
COMPOSE_PROFILES=local-db

# Backend (см. backend/app/core/config.py)
# ВАЖНО перед продакшеном: сгенерируйте длинный случайный секрет, например
# `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=300
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_UPLOAD_SIZE_MB=10
CHECKIN_RADIUS_METERS=5000
# На проде укажите конкретные домены фронтенда через запятую в JSON-массиве,
CORS_ORIGINS=["https://goodwill.ru"]

# Публичный адрес сайта (со схемой, без слэша в конце) — используется для логотипа
# в HTML-письмах с кодом подтверждения. Если пусто, письма отправляются без логотипа.
PUBLIC_BASE_URL=https://goodwill.ru

# Автосоздание единственного администратора при первом старте на пустой БД (см. README).
# Если оставить пустым — админ не создаётся автоматически, заводите вручную через БД.
# Не влияет на уже существующего пользователя с таким логином/почтой (пароль не перезаписывается).
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP — отправка кода подтверждения email при регистрации.
# Если SMTP_HOST оставить пустым, backend не отправляет письма, а пишет код в лог
# (удобно для локальной разработки без реального почтового сервера).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@goodwill.ru
SMTP_USE_TLS=true

# Госуслуги (ЕСИА) — подключение для верификации возраста. Пока GOSUSLUGI_CLIENT_ID пуст, кнопка в профиле показывает «интеграция в разработке» и предлагает ручную верификацию.
GOSUSLUGI_CLIENT_ID=
GOSUSLUGI_CLIENT_SECRET=
GOSUSLUGI_REDIRECT_URI=

# Grafana (статистика активности пользователей, см. docker-compose.yml)
GF_SECURITY_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=

# Web Push — десктопные/браузерные уведомления вне вкладки сайта (Notification API +
# Service Worker). Если оставить пустым, backend просто не отправляет push (уведомления
# в самом сайте продолжают работать как раньше). Сгенерировать свою пару:
#   cd backend && python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@syharik.ru

# Firebase Cloud Messaging — пуши в Android-приложение (GoodWill.apk на Capacitor),
# доставляются даже когда приложение полностью закрыто. Если оставить пустым, backend
# просто не отправляет FCM push (веб-версия и Web Push выше продолжают работать как раньше).
# Получить: console.firebase.google.com → выбрать проект → шестерёнка "Настройки проекта" →
# вкладка "Служебные учётные записи" → "Создать новый закрытый ключ" — скачается .json,
# вставьте его содержимое сюда ОДНОЙ строкой (без переносов).
FIREBASE_CREDENTIALS_JSON=
