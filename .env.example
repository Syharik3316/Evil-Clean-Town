# PostgreSQL
POSTGRES_USER=chistybereg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chistybereg

# Backend (см. backend/app/core/config.py)
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_UPLOAD_SIZE_MB=10
CHECKIN_RADIUS_METERS=500
CORS_ORIGINS=["*"]

# true — заполнить БД демо-данными (сайты, снимки, уроки, ачивки, демо-события)
# при первом запуске на пустой БД. На проде после первого запуска можно
# выставить в false.
SEED_ON_STARTUP=true

# SMTP — отправка кода подтверждения email при регистрации.
# Если SMTP_HOST оставить пустым, backend не отправляет письма, а пишет код в лог
# (удобно для локальной разработки без реального почтового сервера).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@chistybereg.ru
SMTP_USE_TLS=true

# Госуслуги (ЕСИА) — заготовка подключения для верификации возраста, без реального
# использования. Пока GOSUSLUGI_CLIENT_ID пуст, кнопка в профиле показывает
# «интеграция в разработке» и предлагает ручную верификацию.
GOSUSLUGI_CLIENT_ID=
GOSUSLUGI_CLIENT_SECRET=
GOSUSLUGI_REDIRECT_URI=

# Grafana (статистика активности пользователей, см. docker-compose.yml)
GF_SECURITY_ADMIN_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me
