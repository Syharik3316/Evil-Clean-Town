      "datasource": { "type": "postgres", "uid": "chistybereg-postgres" },
      "options": {
        "reduceOptions": { "values": true, "calcs": [], "fields": "" },
        "pieType": "donut",
        "displayLabels": ["percent"],
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "rawSql": "SELECT status AS \"metric\", count(*) AS \"value\" FROM events GROUP BY status ORDER BY 2 DESC",
          "format": "table",
          "refId": "A"
        }
      ]
    },
