    {
      "id": 5,
      "type": "timeseries",
      "title": "Регистрации пользователей по дням",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "chistybereg-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 25, "gradientMode": "opacity", "showPoints": "auto", "pointSize": 4 }
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT $__timeGroupAlias(created_at,'1d'), count(*) AS \"Регистрации\" FROM users WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Входы по дням",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "postgres", "uid": "chistybereg-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 25, "gradientMode": "opacity", "showPoints": "auto", "pointSize": 4 }
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT $__timeGroupAlias(created_at,'1d'), count(*) AS \"Входы\" FROM login_events WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
