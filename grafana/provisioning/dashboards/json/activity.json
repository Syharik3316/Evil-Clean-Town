      "datasource": { "type": "postgres", "uid": "chistybereg-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "gradientMode": "hue" }
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT $__timeGroupAlias(completed_at,'1d'), count(*) AS \"Курсы пройдены\" FROM user_lesson_progress WHERE $__timeFilter(completed_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Подтверждённое участие в мероприятиях (чек-ины) по дням",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "postgres", "uid": "chistybereg-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "gradientMode": "hue" }
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT $__timeGroupAlias(checkin_at,'1d'), count(*) AS \"Чек-ины\" FROM event_registrations WHERE status = 'checked_in' AND $__timeFilter(checkin_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "gauge",
      "title": "Доля принятых репортов",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 32 },
      "datasource": { "type": "postgres", "uid": "chistybereg-postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 40 },
              { "color": "green", "value": 75 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        {
          "rawSql": "SELECT CASE WHEN count(*) = 0 THEN 0 ELSE round(100.0 * count(*) FILTER (WHERE status = 'approved') / count(*), 1) END FROM trash_reports",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Начисленные баллы по дням",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 32 },
      "datasource": { "type": "postgres", "uid": "chistybereg-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "yellow" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 35, "gradientMode": "opacity", "showPoints": "auto", "pointSize": 4 }
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT $__timeGroupAlias(created_at,'1d'), sum(amount) AS \"Баллы\" FROM points_ledger WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
