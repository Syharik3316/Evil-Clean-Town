      "id": 16,
      "type": "bargauge",
      "title": "Баллы команд/школ по городам",
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 40 },
      "datasource": { "type": "postgres", "uid": "chistybereg-postgres" },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] },
      "targets": [
        {
          "rawSql": "SELECT city AS \"metric\", sum(points_total) AS \"value\" FROM teams WHERE city IS NOT NULL GROUP BY city ORDER BY sum(points_total) DESC",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "type": "table",
      "title": "История мероприятий",
      "gridPos": { "h": 8, "w": 14, "x": 10, "y": 40 },
      "datasource": { "type": "postgres", "uid": "chistybereg-postgres" },
      "targets": [
        {
          "rawSql": "SELECT title AS \"Название\", event_type AS \"Тип\", starts_at AS \"Дата\", coalesce(region, '—') AS \"Регион\", status AS \"Статус\" FROM events ORDER BY created_at DESC LIMIT 50",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ]
}
